<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notification locale du récap annuel (Android 13+ uniquement, no-op avant) : voir
         RecapNotificationWorker, demandée après connexion plutôt qu'au lancement du job. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup="false" : rien de ce que l'app stocke sur l'appareil ne part dans la sauvegarde
        Google Drive ni dans un transfert d'appareil — ni la base Room, ni le jeton d'accès IGDB,
        ni la session Firebase. Aucune perte pour l'utilisateur : le backlog est déjà répliqué dans
        Firestore et revient à la reconnexion.
    -->
    <application
        android:name=".CartoucheApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cartouche">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Cartouche"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Désactive l'initialisation automatique de WorkManager (ContentProvider exécuté avant
            même Application.onCreate) : sans ça, WorkManager s'initialise avec sa configuration
            par défaut avant que CartoucheApplication ait pu lui fournir HiltWorkerFactory, et
            RecapNotificationWorker échoue systématiquement (son constructeur généré par Hilt n'a
            pas la signature (Context, WorkerParameters) attendue par la fabrique par réflexion
            par défaut). En la désactivant ici, WorkManager s'initialise à la demande au premier
            WorkManager.getInstance(), et respecte alors CartoucheApplication.Configuration.Provider.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>